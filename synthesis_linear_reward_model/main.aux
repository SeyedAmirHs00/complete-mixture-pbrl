\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Partial and stochastic adversaries (3R1A; \(200\) seeds) for the Stabilized and Consensus branch-symmetry fixes across adversary strengths. Both remain robust well beyond the perfect-flip anti-oracle used in the robotics experiments. Median learned \(\bar  \alpha \) for the adversarial expert (bars) and for the reliable experts (diamond markers). Reliable experts keep high trust throughout, while the adversary's trust rises monotonically from strongly negative (perfect flip) toward positive as it behaves reliably more often, so clean inversion arises only under strong, near-deterministic corruption.}}{16}{figure.caption.20}\protected@file@percent }
\newlabel{fig:partial-adversary}{{5}{16}{Partial and stochastic adversaries (3R1A; \(200\) seeds) for the Stabilized and Consensus branch-symmetry fixes across adversary strengths. Both remain robust well beyond the perfect-flip anti-oracle used in the robotics experiments. Median learned \(\bar \alpha \) for the adversarial expert (bars) and for the reliable experts (diamond markers). Reliable experts keep high trust throughout, while the adversary's trust rises monotonically from strongly negative (perfect flip) toward positive as it behaves reliably more often, so clean inversion arises only under strong, near-deterministic corruption}{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Ablation of practical enhancements (3R1N1A; stabilized \(\hat  R\); \(200\) seeds).} Checkmarks indicate components enabled. Trust is mean \(\bar  \alpha _k\) over experts of each type; reward alignment is \(|\mathrm  {corr}(\hat  R,R^*)|\).}}{16}{table.caption.21}\protected@file@percent }
\newlabel{tab:enhancement-ablation}{{2}{16}{\textbf {Ablation of practical enhancements (3R1N1A; stabilized \(\hat R\); \(200\) seeds).} Checkmarks indicate components enabled. Trust is mean \(\bar \alpha _k\) over experts of each type; reward alignment is \(|\mathrm {corr}(\hat R,R^*)|\)}{table.caption.21}{}}
