\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Every mixture of \(n_A\) adversarial and \(n_N\) noisy experts (remainder reliable; \(100\) seeds per cell); the dashed line marks \(\#\text  {reliable}=\#\text  {adversarial}\) (\(n_N=K-2n_A\)). Standard stays at chance everywhere. Stabilized initialization shows a sharp transition exactly at the dashed line (independent of the noisy count), with adversarial trust flipping from strongly negative (\(\approx -0.65\)) to strongly positive (\(\approx +0.9\)) across it. The consensus anchor follows the same law with a softer boundary and added sensitivity to the noisy fraction.}}{14}{figure.caption.18}\protected@file@percent }
\newlabel{fig:synthetic-ratio-sweep}{{3}{14}{Every mixture of \(n_A\) adversarial and \(n_N\) noisy experts (remainder reliable; \(100\) seeds per cell); the dashed line marks \(\#\text {reliable}=\#\text {adversarial}\) (\(n_N=K-2n_A\)). Standard stays at chance everywhere. Stabilized initialization shows a sharp transition exactly at the dashed line (independent of the noisy count), with adversarial trust flipping from strongly negative (\(\approx -0.65\)) to strongly positive (\(\approx +0.9\)) across it. The consensus anchor follows the same law with a softer boundary and added sensitivity to the noisy fraction}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Median global \(|\mathrm  {corr}(\hat  R,R^*)|\) for TTP as a function of the shared-pair fraction \(q\) (interquartile ranges shaded; \(120\) seeds; 3R1A). Dashed curve: within-block alignment. TTP recovers local orderings at \(q{=}0\) and global alignment once overlap couples blocks across experts.}}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:synthetic-overlap-sweep}{{4}{15}{Median global \(|\mathrm {corr}(\hat R,R^*)|\) for TTP as a function of the shared-pair fraction \(q\) (interquartile ranges shaded; \(120\) seeds; 3R1A). Dashed curve: within-block alignment. TTP recovers local orderings at \(q{=}0\) and global alignment once overlap couples blocks across experts}{figure.caption.19}{}}
