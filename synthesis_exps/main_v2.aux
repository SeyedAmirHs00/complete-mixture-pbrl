\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Overview of TriTrust-PBRL (TTP).} A shared reward \(R(\tau )\) and expert trusts \(\{\alpha _k\}\) are learned jointly from heterogeneous preferences. Under a correct reward branch, reliable experts develop \(\alpha _k>0\), noisy experts \(\alpha _k\approx 0\), and adversarial experts \(\alpha _k<0\) (inversion). The confidence-weighted loss (Eqs.~\eqref  {eq:nll} and~\eqref  {eq:weighted-loss-basic}) aggregates feedback with these trusts; Section~\ref {sec:theory} discusses the residual sign ambiguity that makes a reliable majority necessary for the ``correct'' branch.}}{4}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ttp_overview}{{1}{4}{\textbf {Overview of TriTrust-PBRL (TTP).} A shared reward \(R(\tau )\) and expert trusts \(\{\alpha _k\}\) are learned jointly from heterogeneous preferences. Under a correct reward branch, reliable experts develop \(\alpha _k>0\), noisy experts \(\alpha _k\approx 0\), and adversarial experts \(\alpha _k<0\) (inversion). The confidence-weighted loss (Eqs.~\eqref {eq:nll} and~\eqref {eq:weighted-loss-basic}) aggregates feedback with these trusts; Section~\ref {sec:theory} discusses the residual sign ambiguity that makes a reliable majority necessary for the ``correct'' branch}{figure.caption.3}{}}
\newlabel{fig:a3gcn}{{1}{4}{\textbf {Overview of TriTrust-PBRL (TTP).} A shared reward \(R(\tau )\) and expert trusts \(\{\alpha _k\}\) are learned jointly from heterogeneous preferences. Under a correct reward branch, reliable experts develop \(\alpha _k>0\), noisy experts \(\alpha _k\approx 0\), and adversarial experts \(\alpha _k<0\) (inversion). The confidence-weighted loss (Eqs.~\eqref {eq:nll} and~\eqref {eq:weighted-loss-basic}) aggregates feedback with these trusts; Section~\ref {sec:theory} discusses the residual sign ambiguity that makes a reliable majority necessary for the ``correct'' branch}{figure.caption.3}{}}
